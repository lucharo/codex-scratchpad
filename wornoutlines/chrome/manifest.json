{
  "manifest_version": 3,
  "name": "Worn Out Lines",
  "version": "0.1.0",
  "description": "Visualize line churn on GitHub - see which lines change frequently",
  "permissions": ["storage"],
  "host_permissions": ["https://github.com/*", "https://api.github.com/*"],
  "content_scripts": [
    {
      "matches": ["https://github.com/*/*/blob/*"],
      "js": ["content.js"]
    }
  ]
}
