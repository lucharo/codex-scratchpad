{
  "manifest_version": 3,
  "name": "Line Churn for GitHub",
  "version": "0.1.0",
  "description": "Visualize how frequently each line has been modified in git history",
  "permissions": ["storage"],
  "host_permissions": ["https://github.com/*", "https://api.github.com/*"],
  "content_scripts": [
    {
      "matches": ["https://github.com/*/*/blob/*"],
      "js": ["content.js"],
      "css": ["styles.css"]
    }
  ],
  "icons": {
    "48": "icon.png"
  }
}
